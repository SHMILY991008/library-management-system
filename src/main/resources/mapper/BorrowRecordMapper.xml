<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pp.library.borrow.mapper.BorrowRecordMapper">

    <resultMap id="BorrowRecordResultMap"
               type="com.pp.library.borrow.entity.BorrowRecordEntity">
        <id property="id" column="id"/>
        <result property="bookId" column="book_id"/>
        <result property="readerId" column="reader_id"/>
        <result property="borrowedAt" column="borrowed_at"/>
        <result property="returnedAt" column="returned_at"/>
        <result property="status" column="status"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.pp.library.borrow.entity.BorrowRecordEntity"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO borrow_record (
            book_id,
            reader_id,
            borrowed_at,
            returned_at,
            status
        )
        VALUES (
            #{bookId},
            #{readerId},
            #{borrowedAt},
            #{returnedAt},
            #{status}
        )
    </insert>

    <select id="selectById"
            resultMap="BorrowRecordResultMap">
        SELECT
            id,
            book_id,
            reader_id,
            borrowed_at,
            returned_at,
            status
        FROM borrow_record
        WHERE id = #{id}
    </select>

    <select id="selectByReaderId"
            resultMap="BorrowRecordResultMap">
        SELECT
            id,
            book_id,
            reader_id,
            borrowed_at,
            returned_at,
            status
        FROM borrow_record
        WHERE reader_id = #{readerId}
        ORDER BY borrowed_at DESC
    </select>

    <update id="markReturned">
        UPDATE borrow_record
        SET
            returned_at = NOW(),
            status = 'RETURNED'
        WHERE id = #{id}
          AND status = 'BORROWED'
    </update>

</mapper>