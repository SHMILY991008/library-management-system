[Unit]
Description=Library Management Spring Boot API
After=network.target mysql.service

[Service]
Type=simple
User=libraryapp
Group=libraryapp
WorkingDirectory=/opt/library-management
EnvironmentFile=/etc/library-management/api.env
ExecStart=/usr/bin/java -jar /opt/library-management/library-api.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
