<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pp.library.reader.mapper.ReaderMapper">

    <resultMap id="ReaderResultMap"
               type="com.pp.library.reader.entity.ReaderEntity">
        <id property="id" column="id"/>
        <result property="readerNo" column="reader_no"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="deleted" column="deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.pp.library.reader.entity.ReaderEntity"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO reader (
            reader_no,
            name,
            phone,
            deleted,
            created_at,
            updated_at
        )
        VALUES (
            #{readerNo},
            #{name},
            #{phone},
            #{deleted},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <select id="selectById"
            resultMap="ReaderResultMap">
        SELECT
            id,
            reader_no,
            name,
            phone,
            deleted,
            created_at,
            updated_at
        FROM reader
        WHERE id = #{id}
    </select>

    <select id="selectByReaderNo"
            resultMap="ReaderResultMap">
        SELECT
            id,
            reader_no,
            name,
            phone,
            deleted,
            created_at,
            updated_at
        FROM reader
        WHERE reader_no = #{readerNo}
    </select>

    <select id="selectAll" resultMap="ReaderResultMap">
        SELECT id, reader_no, name, phone, deleted, created_at, updated_at
        FROM reader
        WHERE deleted = 0
        ORDER BY id DESC
    </select>

</mapper>
